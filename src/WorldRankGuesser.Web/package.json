		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"flag-icons": "^7.5.0"
	}
}
