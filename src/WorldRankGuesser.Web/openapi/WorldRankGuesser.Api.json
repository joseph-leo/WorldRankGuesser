{
  "openapi": "3.2.0",
  "info": {
    "title": "WorldRankGuesser.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/games": {
      "post": {
        "tags": [
          "GameEndpoints"
        ],
        "operationId": "StartGame",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/{id}": {
      "get": {
        "tags": [
          "GameEndpoints"
        ],
        "operationId": "GetGame",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/games/{id}/picks": {
      "post": {
        "tags": [
          "GameEndpoints"
        ],
        "operationId": "Pick",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PickRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CellDto": {
        "required": [
          "score",
          "countryRank",
          "entryRank",
          "unranked",
          "sport",
          "event",
          "gender",
          "competitor"
        ],
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "countryRank": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "entryRank": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "unranked": {
            "type": "boolean"
          },
          "sport": {
            "type": [
              "null",
              "string"
            ]
          },
          "event": {
            "type": [
              "null",
              "string"
            ]
          },
          "gender": {
            "type": [
              "null",
              "string"
            ]
          },
          "competitor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CountryDto": {
        "required": [
          "iso3",
          "iso2",
          "name"
        ],
        "type": "object",
        "properties": {
          "iso3": {
            "type": "string"
          },
          "iso2": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GameStateDto": {
        "required": [
          "id",
          "mode",
          "dailyDate",
          "rankMode",
          "cap",
          "categories",
          "picks",
          "currentCountry",
          "deadline",
          "serverNow",
          "isComplete",
          "totalScore",
          "optimalScore",
          "grid"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string"
          },
          "dailyDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "rankMode": {
            "type": "string"
          },
          "cap": {
            "type": "integer",
            "format": "int32"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryDto"
            }
          },
          "picks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PickDto"
            }
          },
          "currentCountry": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CountryDto"
              }
            ]
          },
          "deadline": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "isComplete": {
            "type": "boolean"
          },
          "totalScore": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "optimalScore": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "grid": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GridDto"
              }
            ]
          }
        }
      },
      "GridDto": {
        "required": [
          "countries",
          "cells",
          "bestCategoryIds",
          "optimalCategoryIds"
        ],
        "type": "object",
        "properties": {
          "countries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountryDto"
            }
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CellDto"
              }
            }
          },
          "bestCategoryIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optimalCategoryIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "PickDto": {
        "required": [
          "turnIndex",
          "categoryId",
          "country",
          "score",
          "wasLate",
          "result"
        ],
        "type": "object",
        "properties": {
          "turnIndex": {
            "type": "integer",
            "format": "int32"
          },
          "categoryId": {
            "type": "string"
          },
          "country": {
            "$ref": "#/components/schemas/CountryDto"
          },
          "score": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "wasLate": {
            "type": "boolean"
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CellDto"
              }
            ]
          }
        }
      },
      "PickRequest": {
        "required": [
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StartGameRequest": {
        "required": [
          "mode"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "GameEndpoints"
    }
  ]
}