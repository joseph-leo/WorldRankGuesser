@page "/rankings"

<h3>RankingsPage</h3>

@if (Rankings != null && Rankings.Any())
{
    <ul>
        @foreach (var rank in Rankings)
        {
            <li>@rank.Sport: @rank.Flag @rank.ISO3 @rank.Position</li>
        }
        <li>Total: @Total</li>
    </ul>
}
else
{
    <p>No rankings available.</p>
}

<button class="btn btn-primary" @onclick="NavigateBack">Go Back</button>
